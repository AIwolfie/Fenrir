# Fenrir OSINT Framework Environment Configuration
# Copy this file to .env and adjust values as needed

# Tor Network Settings
TOR_PROXY=socks5h://127.0.0.1:9050
TOR_CONTROL_PORT=9051
TOR_CONTROL_PASSWORD=
TOR_CONTROL_COOKIE=
TOR_CHECK_URL=https://check.torproject.org/api/ip
TOR_GEO_URL=

# Crawler Concurrency & Throttling
CRAWL_DEPTH=2
CRAWL_WORKERS=5
CRAWL_DELAY=1.5
REQUEST_TIMEOUT=30
MAX_RETRIES=3
AUTO_RENEW_AFTER=20
BYPASS_ROBOTS=false

# Plugin Configuration (comma-separated plugin names)
PLUGINS_ENABLED=email_extractor,crypto_detector,pgp_harvester,language_detector,fingerprinter

# Custom Rotating Proxies (optional, comma-separated)
PROXY_LIST=

# Storage & Output Paths
DB_PATH=storage/fenrir.db
REPORTS_PATH=storage/reports/
USER_AGENT=Mozilla/5.0 (compatible; Fenrir/OSINT; Research; by AIwolfie)

# Reporting Options
ENABLE_PDF_EXPORT=false
ENABLE_HEADER_LOGGING=true

# AI Provider Settings (ollama, openai, anthropic, openrouter, gemini)
AI_PROVIDER=ollama
AI_MODEL=llama3
OLLAMA_URL=http://127.0.0.1:11434

# Cloud AI API Keys (leave blank if using local Ollama)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
